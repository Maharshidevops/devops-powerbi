# Copy this to terraform.tfvars and fill in real values.
# Never commit terraform.tfvars to version control.

aws_region          = "us-east-1"
project             = "vidstream"
env                 = "prod"
db_username         = "vidstream_admin"
db_instance_class   = "db.t3.medium"
container_image     = "123456789012.dkr.ecr.us-east-1.amazonaws.com/vidstream-api:abc1234"
acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
container_port      = 8080
